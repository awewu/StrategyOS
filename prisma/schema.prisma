// ─── Market Intelligence · 竞争研究工作台 ────────────────────────────────────
// 治理原则：事业部主建（产品线/对标/研究基线），大区主战（本地价盘/赢丢单/渠道动向）
// 大区直接向主品类事业部总裁汇报，orgUnit 贯穿权限路由

// ── Enums ─────────────────────────────────────────────────────────────────────

enum CompetitorTier {
  core    // 核心对手
  watch   // 重点观察
  fringe  // 边缘
}

enum ThreatLevel {
  critical
  high
  medium
  low
}

enum CompetePosition {
  lead    // 领先
  parity  // 持平
  lag     // 落后
}

enum ResearchStatus {
  todo
  in_progress
  current    // 已更新/现行
  stale      // 需复研
  archived
}

enum SignalReviewStatus {
  draft_ai       // Hermes 起草，待确认
  pending_review // 待人工审核
  confirmed      // 已采纳
  rejected       // 已驳回
}

enum WinLossOutcome {
  win
  loss
  no_decision
}

enum CompetitorType {
  existing     // 现有对手
  new_entrant  // 新进入者
  substitute   // 替代品
}

// ── 产品线主表（事业部主建，归属某事业部 OrgUnit）─────────────────────────────

model MktProductLine {
  id           String   @id @default(uuid())

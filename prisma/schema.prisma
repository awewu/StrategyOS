  ownerName    String?     @map("owner_name") @db.VarChar(50)
  deferUntil   DateTime?   @map("defer_until") @db.Date
  resolution   String?
  commitmentId String?     @map("commitment_id")
  mandateId    String?     @map("mandate_id")
  closedAt     DateTime?   @map("closed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("inbox_records")
}

enum MeetingPollType {
  PRIORITY
  RESOLUTION
  PULSE
}

model MeetingPoll {
  id          String           @id @default(uuid())
  meetingId   String?          @map("meeting_id")
  pollType    MeetingPollType  @map("poll_type")

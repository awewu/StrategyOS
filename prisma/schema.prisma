  title          String        @db.VarChar(200)
  description    String?       @db.Text
  ownerName      String?       @map("owner_name") @db.VarChar(100)
  q1Milestone    String?       @map("q1_milestone") @db.VarChar(200)
  q2Milestone    String?       @map("q2_milestone") @db.VarChar(200)
  q3Milestone    String?       @map("q3_milestone") @db.VarChar(200)
  q4Milestone    String?       @map("q4_milestone") @db.VarChar(200)

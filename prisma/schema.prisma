enum OrgLevel {
  GROUP           // 集团
  EXECUTIVE       // 高管层 (事业部+职能体系)
  OPERATING_UNIT  // 执行层 (二级部门)
}

enum PlanStatus {
  DRAFT      // 草稿
  SUBMITTED  // 已提交
  LOCKED     // 已锁定
}

enum BscDimension {
  FINANCIAL  // 财务
  CUSTOMER   // 客户
  PROCESS    // 流程
  LEARNING   // 学习
}

model OrgUnit {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  nameEn      String?   @map("name_en") @db.VarChar(100)
  level       OrgLevel
  sortOrder   Int       @default(999) @map("sort_order")
  parentId    String?   @map("parent_id")

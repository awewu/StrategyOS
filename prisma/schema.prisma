  active       Boolean  @default(true)
  sortOrder    Int      @default(999) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownerOrg        OrgUnit?           @relation("ProductLineOwner", fields: [ownerOrgId], references: [id])
  cells           CompetitiveCell[]
  specDimensions  ProductSpecDimension[]
  ourProducts     CompetitorProduct[]    @relation("OurMktProductLine")

  @@index([ownerOrgId])
  @@map("mkt_product_lines")
}

// ── 销售大区（大区主战，可关联 OrgUnit）──────────────────────────────────────

model SalesRegion {

  children    OrgUnit[] @relation("OrgTree")
  plans       StrategicPlan[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  productLinesOwned MktProductLine[]  @relation("ProductLineOwner")
  salesRegions      SalesRegion[]      @relation("RegionOrgUnit")
  researchItemsOwned ResearchItem[]    @relation("ResearchItemOwner")

  @@index([level, sortOrder])
  @@index([parentId])
  @@map("org_units")
}

model StrategicPlan {
  id             String          @id @default(uuid())
  orgUnitId      String          @map("org_unit_id")
  orgUnit        OrgUnit         @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  horizonStart   Int             @map("horizon_start")    // 2026
  horizonEnd     Int             @map("horizon_end")      // 2028
  intent         String?         @db.Text                 // 战略意图
  northStar      String?         @map("north_star") @db.VarChar(200)  // 北极星指标
  status         PlanStatus      @default(DRAFT)
  objectives     PlanObjective[]
  initiatives    PlanInitiative[]
  resourceReqs   ResourceRequest[]
  assumptions    PlanAssumption[]
  submittedById  String?         @map("submitted_by_id")
  submittedBy    User?           @relation(fields: [submittedById], references: [id])
  submittedAt    DateTime?       @map("submitted_at")
  lockedAt       DateTime?       @map("locked_at")
  attachments    PlanAttachment[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([orgUnitId, horizonStart, horizonEnd])
  @@index([status])
  @@map("strategic_plans")
}

model PlanObjective {
  id          String        @id @default(uuid())
  planId      String        @map("plan_id")
  plan        StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dimension   BscDimension
  objective   String        @db.Text
  keyResults  PlanKeyResult[]
  sortOrder   Int           @default(999) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")


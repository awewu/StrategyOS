  sortOrder    Int           @default(999) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([objectiveId])
  @@map("plan_key_results")
}

model PlanInitiative {
  id             String        @id @default(uuid())

// StratOS MVP+ · Prisma schema
// Spec: docs/OBJECT_MODEL.md · docs/STRATOS_BLUEPRINT.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ceo
  vp
  pm
  staff
  observer
}

enum SnapshotType {
  H1
  FY
  EVENT
}

enum SnapshotStatus {
  FROZEN
  SUPERSEDED
}

enum WorkingVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum BottleneckType {
  capability
  market
  organization
  capital
}

enum DiagnosisStatus {
  draft
  approved
}

enum BrandCode {
  RUIMEI
  HENGRE
  RUUD
  TECH_HOME
}

enum CynefinDomain {
  clear
  complicated
  complex
  chaotic
}

enum BetGateStatus {
  draft
  review
  approved
  rejected
  killed
  post_invest
  deferred
}

enum FpaToggle {
  on
  off
  deferred
}

enum Horizon {
  H1
  H2
  H3
}

enum InvestmentType {
  strategic
  capacity
  technology
  brand
  people
}

enum HealthAssertionType {
  runway
  compliance
  talent
  brand
}

enum TrafficLight {
  green
  yellow
  red
}

enum StrategyFormationType {
  deliberate
  emergent
  unrealized
  serendipitous
}

enum DiffSeverity {
  info
  warning
  critical
}

enum DiffCategory {
  BSC_TARGET
  OKR_REPLACE
  PROJECT_MIGRATE
  ASSUMPTION_FAILED
  ASSUMPTION_NEW
  DOCTRINE_BREACH
  HEALTH_LIGHT
  COMMITMENT_DROP
  SATISFACTION_FAIL
  RESOURCE_REALLOC
  COMPETITOR_EVENT
  INTENT_CHANGE
  FPA_FORECAST
  CASH_RUNWAY
  EMERGENT_PATTERN
  UNREALIZED
  SERENDIPITOUS
  DELIBERATE_RATE_DROP
  IC_CHANGE
  CAPSTACK_CHANGE
  CAPACITY_GAP
  IC_ROI_DEVIATION
  ROADMAP_SLIP
  PRODUCT_BET_CHANGE
  COMP_GAP_CHANGE
  PRODUCT_MIX_CHANGE
  SEGMENT_PRIORITY
  CHANNEL_CELL_CHANGE
  COVERAGE_TARGET
  LTV_CAC_DETERIORATION
}

enum RiskLevel {
  none
  low
  medium
  high
}

enum ProjectStatus {
  active
  completed
  paused
}

enum AssumptionResult {
  pending
  validated
  failed
}

enum AssumptionType {
  general
  product
  gtm
  capital
}

enum CommitmentStatus {
  pending
  in_progress
  completed
  overdue
}

enum ImpactLevel {
  low
  medium
  high
}

enum DocumentType {
  strategy
  financial
  product
  competitor
  other
}

enum ReportType {
  MON_RPT
  QTR_REV
  SHEET_IMPORT
}

enum FpaLineType {
  revenue
  capex
  opex
  rd
  channel
}

enum FpaScope {
  company
  brand
}

enum DoctrineTag {
  invest
  innovate
  deliver
}

enum SegmentPriority {
  focus
  explore
  defer
}

enum GapAction {
  invest
  outsource
  defer_demand
}

enum GapStatus {
  leading
  parity
  lagging
}

enum RoadmapLane {
  now
  next
  later
}

enum RoadmapStatus {
  planned
  in_progress
  shipped
  deferred
}

enum MaDirection {
  channel
  tech
  jv
  brand
}

enum MaStage {
  watch
  screen
  dd
  signed
  integrating
}

enum TechSignalDomain {
  heat_pump
  controls
  channel_tech
  efficiency
}

enum TechUrgency {
  watch
  act
  invest
}

enum ReportParseStatus {
  pending
  parsed
  failed
}

// ─── Users & governance ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  role      UserRole
  brandTag  String?  @map("brand_tag") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  workingVersionsCreated WorkingVersion[]     @relation("WorkingVersionCreator")
  snapshotsFrozen        StrategicSnapshot[]  @relation("SnapshotFrozenBy")
  diagnosesApproved      StrategicDiagnosis[] @relation("DiagnosisApprover")
  investmentCasesApproved InvestmentCase[]    @relation("IcApprover")
  ownedProjects          Project[]            @relation("ProjectOwner")
  commitments            Commitment[]
  documents              Document[]
  healthExceptions       HealthAssertion[]    @relation("HealthExceptionBy")
  usageLogs              UsageLog[]
  submittedPlans         StrategicPlan[]

  @@map("users")
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userEmail String   @map("user_email") @db.VarChar(100)
  action    String   @db.VarChar(50)
  resource  String   @db.VarChar(200)
  metadata  Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
  @@map("usage_logs")
}

// ─── P0 · Version core ───────────────────────────────────────────────────────

model WorkingVersion {
  id                String               @id @default(uuid())
  period            String               @db.VarChar(10)
  label             String               @db.VarChar(200)
  status            WorkingVersionStatus @default(DRAFT)
  basedOnSnapshotId String?              @map("based_on_snapshot_id")
  createdById       String               @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  basedOnSnapshot StrategicSnapshot? @relation("WorkingVersionBasedOn", fields: [basedOnSnapshotId], references: [id])
  createdBy       User               @relation("WorkingVersionCreator", fields: [createdById], references: [id])
  snapshots       StrategicSnapshot[] @relation("SnapshotFromWorkingVersion")

  diagnoses      StrategicDiagnosis[]
  brandCards     BrandStrategyCard[]
  investmentCases InvestmentCase[]
  productBets    ProductBet[]
  gtmBets        GtmBet[]

  @@index([period, status])
  @@map("working_versions")
}

model StrategicSnapshot {
  id                 String         @id @default(uuid())
  code               String         @unique @db.VarChar(30)
  period             String         @db.VarChar(10)
  snapshotType       SnapshotType   @map("snapshot_type")
  status             SnapshotStatus @default(FROZEN)
  frozenAt           DateTime       @map("frozen_at")
  frozenById         String         @map("frozen_by_id")
  workingVersionId   String?        @map("working_version_id")
  meetingNotes       String?        @map("meeting_notes")
  diagnosisId        String?        @map("diagnosis_id")
  capStackPeriodId   String?        @map("cap_stack_period_id")
  cashPositionId     String?        @map("cash_position_id")
  healthAssertionIds String[]       @map("health_assertion_ids")
  bscLightsAtFreeze  Json           @map("bsc_lights_at_freeze")
  stateJson          Json           @map("state_json")
  createdAt          DateTime       @default(now()) @map("created_at")

  frozenBy         User                @relation("SnapshotFrozenBy", fields: [frozenById], references: [id])
  workingVersion   WorkingVersion?     @relation("SnapshotFromWorkingVersion", fields: [workingVersionId], references: [id])
  diagnosis        StrategicDiagnosis? @relation(fields: [diagnosisId], references: [id])
  capStackPeriod   CapStackPeriod?     @relation(fields: [capStackPeriodId], references: [id])
  cashPosition     CashPosition?       @relation(fields: [cashPositionId], references: [id])
  strategyPattern  StrategyPattern?
  diffsFrom        DiffRecord[]        @relation("DiffFrom")
  diffsTo          DiffRecord[]        @relation("DiffTo")
  workingVersionsBasedOn WorkingVersion[] @relation("WorkingVersionBasedOn")
  frozenAssertions HealthAssertion[]   @relation("AssertionFrozenIn")

  @@index([period])
  @@map("strategic_snapshots")
}

model StrategyPattern {
  id                        String   @id @default(uuid())
  snapshotId                String   @unique @map("snapshot_id")
  deliberateRealizationRate Decimal  @map("deliberate_realization_rate") @db.Decimal(5, 2)
  emergentPatterns          Json     @map("emergent_patterns")
  unrealizedItems           Json     @map("unrealized_items")
  serendipitousItems        Json     @map("serendipitous_items")
  learningPrompts           String[] @map("learning_prompts")
  computedAt                DateTime @map("computed_at")

  snapshot StrategicSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("strategy_patterns")
}

model DiffRecord {
  id             String                  @id @default(uuid())
  fromSnapshotId String                  @map("from_snapshot_id")
  toSnapshotId   String                  @map("to_snapshot_id")
  category       DiffCategory
  severity       DiffSeverity            @default(info)
  title          String                  @db.VarChar(200)
  detail         String?
  objectType     String?                 @map("object_type") @db.VarChar(50)
  objectId       String?                 @map("object_id")
  beforeJson     Json?                   @map("before_json")
  afterJson      Json?                   @map("after_json")
  formationType  StrategyFormationType?  @map("formation_type")
  createdAt      DateTime                @default(now()) @map("created_at")

  fromSnapshot StrategicSnapshot @relation("DiffFrom", fields: [fromSnapshotId], references: [id])
  toSnapshot   StrategicSnapshot @relation("DiffTo", fields: [toSnapshotId], references: [id])

  @@index([fromSnapshotId, toSnapshotId])
  @@map("diff_records")
}

// ─── P0 · I1 / I3 ────────────────────────────────────────────────────────────

model StrategicDiagnosis {
  id                   String           @id @default(uuid())
  period               String           @db.VarChar(10)
  challengeStatement   String           @map("challenge_statement") @db.VarChar(80)
  bottleneckType       BottleneckType   @map("bottleneck_type")
  rootCauses           String[]         @map("root_causes")
  crux                 String           @db.VarChar(120)
  linkedAssumptionIds  String[]         @map("linked_assumption_ids")
  linkedBscMeasureIds  String[]         @map("linked_bsc_measure_ids")
  fpaRationale         String?          @map("fpa_rationale")
  validUntil           DateTime         @map("valid_until") @db.Date
  status               DiagnosisStatus  @default(draft)
  approvedById         String?          @map("approved_by_id")
  approvedAt           DateTime?        @map("approved_at")
  workingVersionId     String?          @map("working_version_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  approvedBy       User?                @relation("DiagnosisApprover", fields: [approvedById], references: [id])
  workingVersion   WorkingVersion?      @relation(fields: [workingVersionId], references: [id])
  snapshots        StrategicSnapshot[]

  @@index([period, status])
  @@map("strategic_diagnoses")
}

model BrandStrategyCard {
  id                    String    @id @default(uuid())
  brandCode             BrandCode @map("brand_code")
  period                String    @db.VarChar(10)
  winningAspiration     String    @map("winning_aspiration") @db.VarChar(60)
  whereToPlayJson       Json      @map("where_to_play_json")
  howToWin              String    @map("how_to_win") @db.VarChar(200)
  mustHaveCapabilities  String[]  @map("must_have_capabilities")
  linkedBscDimensionIds String[]  @map("linked_bsc_dimension_ids")
  linkedObjectiveIds    String[]  @map("linked_objective_ids")
  fpaAnchor             String?   @map("fpa_anchor")
  workingVersionId      String?   @map("working_version_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workingVersion WorkingVersion? @relation(fields: [workingVersionId], references: [id])

  @@unique([brandCode, period, workingVersionId])
  @@map("brand_strategy_cards")
}

// ─── P0 · HealthAssertion (§16.2) ────────────────────────────────────────────

model HealthAssertion {
  id                 String              @id @default(uuid())
  assertionType      HealthAssertionType @map("assertion_type")
  active             Boolean             @default(true)
  triggeredAt        DateTime            @map("triggered_at")
  sourceReportId     String?             @map("source_report_id")
  sourceImportBatch  String?             @map("source_import_batch") @db.VarChar(50)
  message            String              @db.VarChar(300)
  metricValue        Decimal?            @map("metric_value") @db.Decimal(12, 4)
  thresholdValue     Decimal?            @map("threshold_value") @db.Decimal(12, 4)
  remedialVxId       String?             @map("remedial_vx_id")
  clearedAt          DateTime?           @map("cleared_at")
  clearedByReportId  String?             @map("cleared_by_report_id")
  ceoExceptionNote   String?             @map("ceo_exception_note")
  ceoExceptionById   String?             @map("ceo_exception_by_id")
  ceoExceptionAt     DateTime?             @map("ceo_exception_at")
  snapshotId         String?             @map("snapshot_id")
  createdAt          DateTime            @default(now()) @map("created_at")

  sourceReport       Report?             @relation(fields: [sourceReportId], references: [id])
  ceoExceptionBy     User?               @relation("HealthExceptionBy", fields: [ceoExceptionById], references: [id])
  frozenInSnapshot   StrategicSnapshot?  @relation("AssertionFrozenIn", fields: [snapshotId], references: [id])

  @@index([active, assertionType])
  @@map("health_assertions")
}

model HealthSignal {
  id         String       @id @default(uuid())
  period     String       @db.VarChar(10)
  dimension  String       @db.VarChar(20)
  signal     TrafficLight
  kpiName    String?      @map("kpi_name") @db.VarChar(100)
  kpiValue   String?      @map("kpi_value") @db.VarChar(50)
  kpiTarget  String?      @map("kpi_target") @db.VarChar(50)
  recordedAt DateTime     @map("recorded_at")

  @@index([period, dimension])
  @@map("health_signals")
}

model Report {
  id           String     @id @default(uuid())
  reportType   ReportType @map("report_type")
  period       String     @db.VarChar(10)
  title        String     @db.VarChar(200)
  rawContent   String?    @map("raw_content")
  parsedJson   Json?      @map("parsed_json")
  uploadedById String?    @map("uploaded_by_id")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")

  healthAssertions HealthAssertion[]

  @@index([period, reportType])
  @@map("reports")
}

// ─── P1 · CapStack ───────────────────────────────────────────────────────────

model InvestmentCase {
  id                   String         @id @default(uuid())
  code                 String         @unique @db.VarChar(20)
  title                String         @db.VarChar(200)
  type                 InvestmentType
  horizon              Horizon
  period               String         @db.VarChar(10)
  linkedVxId           String?        @map("linked_vx_id")
  linkedAssumptionIds  String[]       @map("linked_assumption_ids")
  linkedOkrIds         String[]       @map("linked_okr_ids")
  capexTotal           Decimal?       @map("capex_total") @db.Decimal(14, 2)
  opexAnnual           Decimal?       @map("opex_annual") @db.Decimal(14, 2)
  expectedIrr          Decimal?       @map("expected_irr") @db.Decimal(6, 4)
  paybackMonths        Int?           @map("payback_months")
  npv                  Decimal?       @db.Decimal(14, 2)
  strategicFitScore    Int?           @map("strategic_fit_score")
  gateStatus           BetGateStatus  @default(draft) @map("gate_status")
  budgetTag            String         @map("budget_tag") @db.VarChar(30)
  fpaToggle            FpaToggle      @default(off) @map("fpa_toggle")
  doctrineAuditId      String?        @map("doctrine_audit_id")
  cynefinDomain        CynefinDomain? @map("cynefin_domain")
  approvedAt           DateTime?      @map("approved_at")
  approvedById         String?        @map("approved_by_id")
  workingVersionId     String?        @map("working_version_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  linkedVx         Project?          @relation(fields: [linkedVxId], references: [id])
  approvedBy       User?             @relation("IcApprover", fields: [approvedById], references: [id])
  workingVersion   WorkingVersion?   @relation(fields: [workingVersionId], references: [id])
  fpaBudgetLines   FpaBudgetLine[]
  capacitySnapshots CapacitySnapshot[]
  productBetsLinked ProductBet[]

  @@index([period, gateStatus])
  @@index([budgetTag])
  @@map("investment_cases")
}

model CapStackPeriod {
  id                   String   @id @default(uuid())
  period               String   @unique @db.VarChar(10)
  capexBudget          Decimal  @map("capex_budget") @db.Decimal(14, 2)
  capexCommitted       Decimal  @map("capex_committed") @db.Decimal(14, 2)
  capexSpent           Decimal  @map("capex_spent") @db.Decimal(14, 2)
  opexInvestmentBudget Decimal  @map("opex_investment_budget") @db.Decimal(14, 2)
  byHorizonJson        Json     @map("by_horizon_json")
  byBrandJson          Json     @map("by_brand_json")
  byTypeJson           Json     @map("by_type_json")
  cashPeakMonth        String?  @map("cash_peak_month") @db.VarChar(7)
  cashPeakAmount       Decimal? @map("cash_peak_amount") @db.Decimal(14, 2)
  runwayAfterPeak      Decimal? @map("runway_after_peak") @db.Decimal(6, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  snapshots StrategicSnapshot[]

  @@map("cap_stack_periods")
}

model CapacitySnapshot {
  id                   String    @id @default(uuid())
  period               String    @db.VarChar(10)
  demandUnits          Decimal   @map("demand_units") @db.Decimal(12, 2)
  capacityUnits        Decimal   @map("capacity_units") @db.Decimal(12, 2)
  utilizationPct       Decimal   @map("utilization_pct") @db.Decimal(5, 2)
  gapUnits             Decimal   @map("gap_units") @db.Decimal(12, 2)
  gapAction            GapAction @map("gap_action")
  linkedInvestmentCaseId String? @map("linked_investment_case_id")
  bottleneckAsset      String?   @map("bottleneck_asset") @db.VarChar(200)
  recordedAt           DateTime  @map("recorded_at")

  linkedInvestmentCase InvestmentCase? @relation(fields: [linkedInvestmentCaseId], references: [id])

  @@index([period])
  @@map("capacity_snapshots")
}

// ─── P1 · ProdStack ──────────────────────────────────────────────────────────

model ProductLine {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(20)
  name             String   @db.VarChar(100)
  brandCode        BrandCode @map("brand_code")
  horizon          Horizon?
  lifecycleStage   String?  @map("lifecycle_stage") @db.VarChar(30)
  revenueSharePct  Decimal? @map("revenue_share_pct") @db.Decimal(5, 2)
  linkedBscMeasureId String? @map("linked_bsc_measure_id")
  createdAt        DateTime @default(now()) @map("created_at")

  jtbdCards  JtbdCard[]
  roadmapItems ProductRoadmapItem[]
  gaps       CompetitiveProductGap[]
  productBets ProductBet[] @relation("ProductBetLines")

  @@map("product_lines")
}

model JtbdCard {
  id              String   @id @default(uuid())
  productLineId   String   @map("product_line_id")
  statement       String   @db.VarChar(200)
  primarySegment  String   @map("primary_segment") @db.VarChar(50)
  outcomeMetrics  String[] @map("outcome_metrics")
  linkedOkrIds    String[] @map("linked_okr_ids")

  productLine ProductLine @relation(fields: [productLineId], references: [id])

  @@map("jtbd_cards")
}

model ProductRoadmapItem {
  id                 String        @id @default(uuid())
  productLineId      String        @map("product_line_id")
  lane               RoadmapLane
  milestone          String        @db.VarChar(200)
  targetQuarter      String        @map("target_quarter") @db.VarChar(7)
  status             RoadmapStatus @default(planned)
  linkedVxId         String?       @map("linked_vx_id")
  linkedAssumptionIds String[]     @map("linked_assumption_ids")
  confidence         Decimal?      @db.Decimal(3, 2)

  productLine ProductLine @relation(fields: [productLineId], references: [id])
  linkedVx    Project?    @relation(fields: [linkedVxId], references: [id])

  @@map("product_roadmap_items")
}

model CompetitiveProductGap {
  id            String    @id @default(uuid())
  productLineId String    @map("product_line_id")
  competitor    String    @db.VarChar(50)
  dimension     String    @db.VarChar(50)
  ourStatus     GapStatus @map("our_status")
  closureVxId   String?   @map("closure_vx_id")
  notes         String?

  productLine ProductLine @relation(fields: [productLineId], references: [id])
  closureVx   Project?    @relation("GapClosureVx", fields: [closureVxId], references: [id])

  @@map("competitive_product_gaps")
}

model ProductBet {
  id                      String         @id @default(uuid())
  title                   String         @db.VarChar(200)
  period                  String         @db.VarChar(10)
  horizon                 Horizon
  linkedDiagnosisCrux     String?        @map("linked_diagnosis_crux") @db.VarChar(120)
  linkedVxIds             String[]       @map("linked_vx_ids")
  linkedIcId              String?        @map("linked_ic_id")
  successCriteria         String[]       @map("success_criteria")
  killCriteria            String[]       @map("kill_criteria")
  budgetTag               String?        @map("budget_tag") @db.VarChar(30)
  fpaToggle               FpaToggle      @default(off) @map("fpa_toggle")
  gateStatus              BetGateStatus  @default(draft) @map("gate_status")
  doctrineInnovateAuditId String?        @map("doctrine_innovate_audit_id")
  cynefinDomain           CynefinDomain? @map("cynefin_domain")
  workingVersionId        String?        @map("working_version_id")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  linkedIc       InvestmentCase? @relation(fields: [linkedIcId], references: [id])
  workingVersion WorkingVersion? @relation(fields: [workingVersionId], references: [id])
  productLines   ProductLine[]   @relation("ProductBetLines")
  fpaBudgetLines FpaBudgetLine[]

  @@index([period, gateStatus])
  @@map("product_bets")
}

// ─── P1 · GtmStack ───────────────────────────────────────────────────────────

model CustomerSegment {
  id              String          @id @default(uuid())
  code            String          @unique @db.VarChar(20)
  name            String          @db.VarChar(100)
  priority        SegmentPriority @default(explore)
  horizon         Horizon?
  jtbdSummary     String?         @map("jtbd_summary") @db.VarChar(200)
  linkedJtbdIds   String[]        @map("linked_jtbd_ids")
  createdAt       DateTime        @default(now()) @map("created_at")

  brandChannelCells BrandChannelCell[]
  gtmBets           GtmBet[]
  segmentEconomics  SegmentEconomics[]

  @@map("customer_segments")
}

model BrandChannelCell {
  id              String    @id @default(uuid())
  brandCode       BrandCode @map("brand_code")
  channelCode     String    @map("channel_code") @db.VarChar(30)
  segmentId       String?   @map("segment_id")
  role            String    @db.VarChar(20)
  priority        String    @db.VarChar(5)
  targetCoverage  Int?      @map("target_coverage")
  linkedKrIds     String[]  @map("linked_kr_ids")

  segment CustomerSegment? @relation(fields: [segmentId], references: [id])
  gtmBets GtmBet[]

  @@unique([brandCode, channelCode, segmentId])
  @@map("brand_channel_cells")
}

model GtmBet {
  id                   String         @id @default(uuid())
  title                String         @db.VarChar(200)
  period               String         @db.VarChar(10)
  segmentId            String?        @map("segment_id")
  brandChannelCellId   String?        @map("brand_channel_cell_id")
  successCriteria      String[]       @map("success_criteria")
  killCriteria         String[]       @map("kill_criteria")
  linkedAssumptionIds  String[]       @map("linked_assumption_ids")
  linkedIcId           String?        @map("linked_ic_id")
  budgetTag            String?        @map("budget_tag") @db.VarChar(30)
  fpaToggle            FpaToggle      @default(off) @map("fpa_toggle")
  gateStatus           BetGateStatus  @default(draft) @map("gate_status")
  doctrineTags         DoctrineTag[]  @map("doctrine_tags")
  workingVersionId     String?        @map("working_version_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  segment          CustomerSegment?  @relation(fields: [segmentId], references: [id])
  brandChannelCell BrandChannelCell? @relation(fields: [brandChannelCellId], references: [id])
  workingVersion   WorkingVersion?   @relation(fields: [workingVersionId], references: [id])

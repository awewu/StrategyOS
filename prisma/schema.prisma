// ── Compass: 使命/愿景/5年终点 + 里程碑路径 + 假设前提审计 ─────────────

model CompanyNorthStar {
  id          String   @id @default(uuid())
  version     Int      @default(1)
  active      Boolean  @default(true)
  mission     String   @db.VarChar(500)          // 使命：为何存在
  vision      String   @db.VarChar(500)          // 愿景：10年后的形态
  targetYear  Int      @map("target_year")       // e.g. 2030
  // 5年量化终点
  revenueTarget     Decimal  @map("revenue_target") @db.Decimal(14,2)      // 万元
  profitMarginTarget Decimal @map("profit_margin_target") @db.Decimal(5,4) // 0-1
  marketPositionDesc String? @map("market_position_desc") @db.VarChar(200) // 目标市场地位描述
  geographyDesc     String? @map("geography_desc") @db.VarChar(200)        // 目标地理覆盖
  brandDesc         String? @map("brand_desc") @db.VarChar(200)            // 目标品牌格局
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  milestones  CompassMilestone[]
  premiseAudit CompassPremiseAudit[]

  @@map("company_north_stars")
}

model CompassMilestone {
  id            String   @id @default(uuid())
  northStarId   String   @map("north_star_id")
  year          Int                               // 2026/2027/2028/2030
  label         String   @db.VarChar(100)        // e.g. "站稳2亿"
  revenueTarget Decimal? @map("revenue_target") @db.Decimal(14,2)
  profitMarginTarget Decimal? @map("profit_margin_target") @db.Decimal(5,4)
  keyConditions String[] @map("key_conditions")  // 到达这个里程碑必须满足的条件
  // 实时进度（由系统从FPA/OpsMetric拉取，手动可覆盖）
  revenueActual Decimal? @map("revenue_actual") @db.Decimal(14,2)
  progressNote  String?  @map("progress_note") @db.VarChar(500)
  riskScore     Int?     @map("risk_score")      // 0-100，由反推引擎计算
  riskFactors   String[] @map("risk_factors")    // 自动识别的主要风险项
  updatedAt     DateTime @updatedAt @map("updated_at")
  northStar     CompanyNorthStar @relation(fields: [northStarId], references: [id], onDelete: Cascade)

  @@index([northStarId, year])
  @@map("compass_milestones")
}

model CompassPremiseAudit {
  id            String   @id @default(uuid())
  northStarId   String   @map("north_star_id")
  // 每条假设前提
  code          String   @db.VarChar(20)         // e.g. "P1"
  premise       String   @db.VarChar(500)        // 假设内容
  category      String   @db.VarChar(50)         // market/technology/regulation/competition/capability
  // 置信度 & 脆弱性
  confidence    Int      @default(50)            // 0-100
  fragility     Int      @default(50)            // 0-100：如果失效，对战略的伤害程度
  lastValidatedAt DateTime? @map("last_validated_at")
  validationNote String?  @map("validation_note") @db.VarChar(500)
  // 失效信号（Hermes可自动标记）
  failSignal    String?  @map("fail_signal") @db.VarChar(300)
  signalSource  String?  @map("signal_source") @db.VarChar(100)
  signalAt      DateTime? @map("signal_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  northStar     CompanyNorthStar @relation(fields: [northStarId], references: [id], onDelete: Cascade)

  @@map("compass_premise_audits")
}

// ── 战略职责主线 (事在前) + 会议时点 + 当期责任切片 (人在后) ──────────────
// 设计原则: 战略职责(StrategyMandate)是第一性的、跨会议延续的主线;
// 会议(StrategyMeeting)是职责被认领/交账/移交的时点;
// 当期责任人(MandateHolding)是职责在某次会议上的人事快照, 人变线不断。

enum MandateStatus {
  ACTIVE        // 进行中
  AT_RISK       // 有风险
  ON_HOLD       // 暂缓
  CLOSED        // 已结案
}

enum MeetingType {
  MID_YEAR      // 年中战略会
  YEAR_END      // 年底战略会
  TOPIC         // 专题会
  REVIEW        // 复盘会
}

enum MeetingStatus {
  INVITING      // 邀请中
  IN_PROGRESS   // 进行中
  ARCHIVED      // 已存档
}

enum HoldingStatus {
  CLAIMED       // 已认领
  DELIVERED     // 已交账
  HANDED_OVER   // 已移交
  MISSED        // 未交账
}

model StrategyMandate {
  id            String         @id @default(uuid())
  code          String         @unique @db.VarChar(20)   // e.g. M-V4
  title         String         @db.VarChar(200)          // 议题/职责标题
  theme         String?        @db.VarChar(100)          // 所属战略主题
  description   String?                                  // 职责说明
  status        MandateStatus  @default(ACTIVE)
  closed        Boolean        @default(false)
  originMeetingId String?      @map("origin_meeting_id")  // 起始会议
  linkedProjectCode    String? @map("linked_project_code") @db.VarChar(10)
  linkedAssumptionCode String? @map("linked_assumption_code") @db.VarChar(10)
  sortOrder     Int            @default(999) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  holdings      MandateHolding[]

  @@index([status])
  @@map("strategy_mandates")
}

model StrategyMeeting {
  id            String         @id @default(uuid())
  title         String         @db.VarChar(200)
  meetingType   MeetingType    @map("meeting_type")
  period        String         @db.VarChar(10)            // e.g. 2026-FY
  meetingDate   DateTime?      @map("meeting_date") @db.Date
  status        MeetingStatus  @default(INVITING)
  agenda        String?                                   // 会议主题/议程
  notes         String?                                   // 纪要
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  holdings      MandateHolding[]
  polls         MeetingPoll[]

  @@index([period])
  @@map("strategy_meetings")
}

model MandateHolding {
  id            String         @id @default(uuid())
  mandateId     String         @map("mandate_id")
  meetingId     String         @map("meeting_id")
  // 当期人事快照 (自由文本, 因为人会调动)
  holderName    String         @map("holder_name") @db.VarChar(50)   // 当期责任人
  holderRole    String         @map("holder_role") @db.VarChar(100)  // 当期参会角色
  // 邀请/参会两时点
  invitedAt     DateTime?      @map("invited_at")
  attendedAt    DateTime?      @map("attended_at")
  status        HoldingStatus  @default(CLAIMED)
  // 本期承诺/交账
  commitment    String?                                   // 本期承诺内容
  deadline      DateTime?      @db.Date                    // 承诺截止
  deliveryNote  String?        @map("delivery_note")       // 交账说明
  handoverNote  String?        @map("handover_note")       // 移交说明 (换人时)
  handoverToName String?       @map("handover_to_name") @db.VarChar(50)  // 移交给谁
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  mandate       StrategyMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  meeting       StrategyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([mandateId])
  @@index([meetingId])
  @@map("mandate_holdings")
}

// ── 交付闭环: Inbox 处置 + 会议工具 ─────────────────────────────────────

enum InboxStatus {
  OPEN
  DEFERRED
  ASSIGNED
  CLOSED
}

model InboxRecord {

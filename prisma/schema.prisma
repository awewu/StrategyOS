model CompetitorBrand {
  id            String         @id @default(uuid())
  name          String         @unique @db.VarChar(80)
  nameEn        String?        @map("name_en") @db.VarChar(80)
  competitorType CompetitorType @default(existing) @map("competitor_type")
  tier          CompetitorTier @default(watch)
  threatLevel   ThreatLevel    @default(medium)
  hq            String?        @db.VarChar(80)
  positioning   String?        @db.Text
  active        Boolean        @default(true)
  sortOrder     Int            @default(999) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  products      CompetitorProduct[]
  cells         CompetitiveCell[]
  researchItems ResearchItem[]
  winLossRecords WinLossRecord[]
  battlecards   Battlecard[]

  @@index([tier, active])
  @@map("competitor_brands")
}

// ── 重点产品库（竞品 + 我方，均挂产品线）────────────────────────────────────

model CompetitorProduct {
  id             String    @id @default(uuid())
  brandId        String?   @map("brand_id")         // null = 我方产品
  productLineId  String?   @map("product_line_id")   // 归属产品线
  isOurs         Boolean   @default(false) @map("is_ours")
  name           String    @db.VarChar(120)
  modelCode      String?   @map("model_code") @db.VarChar(60)
  priceMin       Decimal?  @map("price_min") @db.Decimal(12, 2)
  priceMax       Decimal?  @map("price_max") @db.Decimal(12, 2)
  launchDate     DateTime? @map("launch_date") @db.Date
  lifecycle      String?   @db.VarChar(30)           // 新品/主力/成熟/EOL
  tracked        Boolean   @default(true)
  positioning    String?   @db.Text
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date  // 防基准腐烂
  sortOrder      Int       @default(999) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  brand       CompetitorBrand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productLine MktProductLine?      @relation("OurMktProductLine", fields: [productLineId], references: [id])
  specs       ProductSpecValue[]
  priceHistory CompetitorMetricPoint[] @relation("ProductPriceHistory")

  @@index([brandId, tracked])
  @@index([productLineId])
  @@map("competitor_products")
}

// ── 产品规格维度定义（事业部配置，可增删）────────────────────────────────────

model ProductSpecDimension {
  id           String   @id @default(uuid())
  productLineId String  @map("product_line_id")
  key          String   @db.VarChar(60)             // cop / capacity / noise
  label        String   @db.VarChar(80)             // 能效 COP
  unit         String?  @db.VarChar(30)             // W/W
  higherBetter Boolean  @default(true) @map("higher_better")
  weight       Int      @default(1)
  sortOrder    Int      @default(999) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  productLine MktProductLine       @relation(fields: [productLineId], references: [id], onDelete: Cascade)
  values      ProductSpecValue[]

  @@unique([productLineId, key])
  @@index([productLineId, sortOrder])
  @@map("product_spec_dimensions")
}

// ── 产品规格值（含 admitalty 可信度 + 人工修订标记）────────────────────────

model ProductSpecValue {
  id            String           @id @default(uuid())
  productId     String           @map("product_id")
  dimensionId   String           @map("dimension_id")
  valueNum      Decimal?         @map("value_num") @db.Decimal(14, 4)
  valueText     String?          @map("value_text") @db.VarChar(200)
  position      CompetePosition?
  note          String?          @db.VarChar(300)
  editedManually Boolean         @default(false) @map("edited_manually")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  product   CompetitorProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  dimension ProductSpecDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@unique([productId, dimensionId])
  @@map("product_spec_values")
}

// ── 时间序列指标（价格/渠道签约数等变化率）────────────────────────────────

model CompetitorMetricPoint {
  id          String   @id @default(uuid())
  productId   String?  @map("product_id")           // 挂具体产品（价格）
  brandId     String?  @map("brand_id")             // 或挂品牌（渠道签约数）
  regionId    String?  @map("region_id")
  metricKey   String   @map("metric_key") @db.VarChar(60)  // price / dealer_count
  value       Decimal  @db.Decimal(14, 4)
  period      String   @db.VarChar(10)              // 2026-06
  source      String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  product  CompetitorProduct? @relation("ProductPriceHistory", fields: [productId], references: [id])

  @@index([metricKey, period])
  @@index([brandId, metricKey])
  @@map("competitor_metric_points")
}

// ── 三维竞争单元（产品线 × 大区 × 竞品）─────────────────────────────────────
// 按需创建，空格子 = 未覆盖战场 = 盲区预警

model CompetitiveCell {
  id              String          @id @default(uuid())
  productLineId   String          @map("product_line_id")
  regionId        String          @map("region_id")
  competitorId    String          @map("competitor_id")
  threatLevel     ThreatLevel     @default(medium) @map("threat_level")
  ourPosition     CompetePosition @default(parity) @map("our_position")
  marketShareEst  Decimal?        @map("market_share_est") @db.Decimal(5, 2)
  priceIndexUs    Decimal?        @map("price_index_us") @db.Decimal(6, 2)   // 我方=100
  dealerCountComp Int?            @map("dealer_count_comp")
  dealerCountUs   Int?            @map("dealer_count_us")
  summary         String?         @db.Text          // 该战场一句话结论
  // 人工修订主轴
  editedManually  Boolean         @default(false) @map("edited_manually")
  lastReviewedAt  DateTime?       @map("last_reviewed_at") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  productLine  MktProductLine     @relation(fields: [productLineId], references: [id])
  region       SalesRegion     @relation(fields: [regionId], references: [id])
  competitor   CompetitorBrand @relation(fields: [competitorId], references: [id])
  researchItems ResearchItem[]
  winLossRecords WinLossRecord[]

  @@unique([productLineId, regionId, competitorId])
  @@index([productLineId, threatLevel])
  @@index([regionId])
  @@map("competitive_cells")
}

// ── 四维研究画布（事业部主建基线，大区可补充本地洞察）──────────────────────

model ResearchItem {
  id              String         @id @default(uuid())
  cellId          String?        @map("cell_id")      // 挂三维单元（可选）
  brandId         String         @map("brand_id")
  dimension       IntelDimension
  subtopic        String         @db.VarChar(80)       // 技术路线/渠道结构/品牌定位/并购战略
  status          ResearchStatus @default(todo)
  findings        String?        @db.Text
  evidence        String?        @db.Text
  ownerOrgId      String?        @map("owner_org_id")  // 事业部 or 大区
  ownerName       String?        @map("owner_name") @db.VarChar(60)
  confidence      Int            @default(50)          // 0-100
  // Admiralty 双维度可信度
  sourceReliability String?      @map("source_reliability") @db.VarChar(2) // A-F
  infoCredibility   Int?         @map("info_credibility")                   // 1-6
  reviewEveryDays   Int          @default(30) @map("review_every_days")
  lastReviewedAt    DateTime?    @map("last_reviewed_at") @db.Date
  // 人工修订主轴
  origin            String       @default("manual") @db.VarChar(20) // manual/hermes
  editedManually    Boolean      @default(false) @map("edited_manually")
  sortOrder         Int          @default(999) @map("sort_order")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  cell     CompetitiveCell? @relation(fields: [cellId], references: [id])
  brand    CompetitorBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ownerOrg OrgUnit?         @relation("ResearchItemOwner", fields: [ownerOrgId], references: [id])

  @@index([brandId, dimension])
  @@index([status])
  @@index([cellId])
  @@map("research_items")
}

// ── 赢单/丢单记录（大区录入，挂产品线+大区+竞品）────────────────────────────

model WinLossRecord {
  id             String         @id @default(uuid())
  outcome        WinLossOutcome
  cellId         String?        @map("cell_id")
  regionId       String         @map("region_id")
  competitorId   String?        @map("competitor_id")
  productLineId  String?        @map("product_line_id")  // 冗余方便聚合
  projectName    String?        @map("project_name") @db.VarChar(200)
  dealSizeCny    Decimal?       @map("deal_size_cny") @db.Decimal(14, 2)
  lossReason     String?        @map("loss_reason") @db.Text
  winReason      String?        @map("win_reason") @db.Text
  customerType   String?        @map("customer_type") @db.VarChar(60) // 酒店/家装/工程
  recordedById   String?        @map("recorded_by_id")
  recordedAt     DateTime       @map("recorded_at") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")

  cell       CompetitiveCell? @relation(fields: [cellId], references: [id])
  region     SalesRegion      @relation(fields: [regionId], references: [id])
  competitor CompetitorBrand? @relation(fields: [competitorId], references: [id])

  @@index([regionId, outcome])
  @@index([competitorId, outcome])
  @@index([productLineId])
  @@map("win_loss_records")
}

// ── Battlecard（一线销售用，事业部/品类团队维护）────────────────────────────

model Battlecard {
  id              String   @id @default(uuid())
  competitorId    String   @map("competitor_id")
  productLineId   String?  @map("product_line_id")
  headline        String   @db.VarChar(200)        // 打赢这一单的核心论点
  ourStrengths    String[] @map("our_strengths")
  theirWeaknesses String[] @map("their_weaknesses")
  traps           String[] // 对方常用陷阱
  responses       String[] // 我方应对话术
  editedManually  Boolean  @default(true) @map("edited_manually")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  competitor   CompetitorBrand @relation(fields: [competitorId], references: [id])

  @@unique([competitorId, productLineId])
  @@map("battlecards")
}

// ── IntelSignal 评审状态扩展（Hermes 起草 → 人工确认 → 进研究画布）──────────
// 通过迁移脚本将 review_status 加到 intel_signals 表，此处用独立扩展表
model IntelSignalReview {
  id           String            @id @default(uuid())
  signalId     String            @unique @map("signal_id")
  status       SignalReviewStatus @default(draft_ai)
  reviewerName String?           @map("reviewer_name") @db.VarChar(60)
  reviewNote   String?           @map("review_note") @db.Text
  reviewedAt   DateTime?         @map("reviewed_at")
  // 信号影响：是否驱动情景概率
  linkedScenarioCode String?     @map("linked_scenario_code") @db.VarChar(30)
  scenarioProbabilityDelta Decimal? @map("scenario_probability_delta") @db.Decimal(5, 3)
  createdAt    DateTime          @default(now()) @map("created_at")

  signal IntelSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("intel_signal_reviews")
}

// ── IntelReport（态势报告，Hermes 起草，人工确认才发布）──────────────────────

model IntelReport {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(200)
  period        String   @db.VarChar(10)
  scope         String?  @db.VarChar(200)           // 产品线/大区/全局
  status        SignalReviewStatus @default(draft_ai)
  content       String?  @db.Text                   // Hermes 生成的报告草稿
  editedContent String?  @map("edited_content") @db.Text  // 人工修订后的版本
  confirmedById String?  @map("confirmed_by_id")
  confirmedAt   DateTime? @map("confirmed_at")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([period, status])
  @@map("intel_reports")
}

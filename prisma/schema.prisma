  @@index([metricKey, period])
  @@index([brandId, metricKey])
  @@map("competitor_metric_points")
}

model CompetitiveCell {
  id              String          @id @default(uuid())
  productLineId   String          @map("product_line_id")
  regionId        String          @map("region_id")

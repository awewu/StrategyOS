  createdAt    DateTime @default(now()) @map("created_at")

  parent    SalesRegion?  @relation("RegionTree", fields: [parentId], references: [id])
  children  SalesRegion[] @relation("RegionTree")
  orgUnit   OrgUnit?      @relation("RegionOrgUnit", fields: [orgUnitId], references: [id])
  cells     CompetitiveCell[]
  winLoss   WinLossRecord[]

  @@index([parentId])
  @@map("sales_regions")
}


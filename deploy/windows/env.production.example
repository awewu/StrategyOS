NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL 16+
# Example: postgresql://stratos_user:change_me@127.0.0.1:5432/stratos?connection_limit=10&pool_timeout=10
DATABASE_URL=

# Public HTTPS origin served by Nginx.
STRATOS_PUBLIC_URL=
STRATOS_BASE_URL=

# Production auth.
STRATOS_REQUIRE_AUTH=1
STRATOS_SESSION_SECRET=
# Set to 1 only for initial deployment without WorkOS SSO.
STRATOS_SKIP_ENV_VALIDATE=0

# WorkOS AuthKit.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=
WORKOS_ORGANIZATION_ID=
WORKOS_WEBHOOK_SECRET=

# Tandem SSO (OpenID Connect — ai.rhautt.com). Register redirect_uri at https://ai.rhautt.com/admin/sso.
# Redirect must match exactly (scheme/host/port/path).
TANDEM_CLIENT_ID=
TANDEM_CLIENT_SECRET=
TANDEM_REDIRECT_URI=
TANDEM_ISSUER=https://ai.rhautt.com
TANDEM_SCOPES=openid profile email roles org

# Optional LLM integration.
OPENAI_API_KEY=
STRATOS_LLM_BASE_URL=https://api.openai.com/v1
STRATOS_LLM_MODEL=gpt-4o-mini

# Business defaults.
ORG_UNIT_ID=org-group-rhautt
HORIZON_START=2026
HORIZON_END=2028


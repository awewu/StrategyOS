# ── Database ──────────────────────────────────────────────────────────────
# Docker: postgresql://postgres:postgres@localhost:5432/stratos
# Homebrew (macOS): postgresql://$(whoami)@localhost:5432/stratos
# connection_limit caps Prisma pool size (dev default 5 is applied in lib/db.ts if omitted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stratos?connection_limit=5"

# ── Server ────────────────────────────────────────────────────────────────
# Local dev default 3003 (avoids PLM on 3000). Docker image listens on 3000 — see Dockerfile.
PORT=3003
# Public URL for WorkOS redirects / webhooks (production required)
# STRATOS_PUBLIC_URL=https://stratos.example.com
# Base URL for smoke/preflight HTTP probes (defaults to http://127.0.0.1:$PORT)
# STRATOS_BASE_URL=http://localhost:3003

# ── Production auth (~30 users) ───────────────────────────────────────────
# Required for go-live (validated on boot when NODE_ENV=production):
STRATOS_REQUIRE_AUTH=1
STRATOS_SESSION_SECRET=                    # min 32 chars — openssl rand -base64 32
STRATOS_PUBLIC_URL=https://stratos.example.com

# Optional: validate env in dev/test (production always validates on boot)
# STRATOS_VALIDATE_ENV=1
# STRATOS_SKIP_ENV_VALIDATE=1                # emergency bypass only

# Production emergency bypass: allow demo fallback when DB is unavailable (NOT for normal ops)
# STRATOS_ALLOW_DEMO_FALLBACK=1

# Dev-only role override when auth not required (ignored in production + STRATOS_REQUIRE_AUTH=1)
# STRATOS_DEV_ROLE=admin

# ── WorkOS Enterprise SSO (AuthKit) ───────────────────────────────────────
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_...
# WORKOS_REDIRECT_URI=http://localhost:3003/api/auth/callback
# WORKOS_ORGANIZATION_ID=org_...
# WORKOS_WEBHOOK_SECRET=whsec_...

# ── Tandem SSO (OpenID Connect — ai.rhautt.com) ───────────────────────────
# Confidential client (server-side). Register your app + redirect_uri at
# https://ai.rhautt.com/admin/sso. Redirect must match TANDEM_REDIRECT_URI exactly.
# TANDEM_CLIENT_ID=cli_...
# TANDEM_CLIENT_SECRET=...
# TANDEM_REDIRECT_URI=http://localhost:3003/api/auth/tandem/callback
# TANDEM_ISSUER=https://ai.rhautt.com               # default; override for staging
# TANDEM_SCOPES=openid profile email roles org      # default

# ── LLM (report parsing / Agent — optional) ───────────────────────────────
# OPENAI_API_KEY=sk-...
# STRATOS_LLM_API_KEY=sk-...                 # alias for OPENAI_API_KEY
# STRATOS_LLM_BASE_URL=https://api.openai.com/v1
# STRATOS_LLM_MODEL=gpt-4o-mini              # 通用模型（报告解析、Agent）
# STRATOS_LLM_EXTRACT_MODEL=gpt-4o           # 战略文件提取专用，默认 gpt-4o（不设则同上）
# STRATOS_OCR_MODEL=qwen-vl-plus              # 百炼视觉 OCR，用于无文本层或乱码 PDF

# ── 中央 AI 战略感知桥 (Tandem CompanyBrain "战略之眼" — optional) ──────────
# GET /api/strategy/perception-digest 只读暴露战略合理性传感器给 Tandem 中央 AI。
# 值需与 Hermes 侧 STRATOS_PERCEPTION_TOKEN 一致; 未配置则端点返回 503 (未启用)。
# 生成: openssl rand -base64 32
# STRATOS_PERCEPTION_TOKEN=
#
# 反向: 季度合理性复盘调 Tandem 中央 AI 求裁决建议 (persevere/pivot/kill)。
# 值需与 Hermes 侧 STRATEGY_VERDICT_TOKEN 一致; 未配置则降级为本地规则引擎。
# HERMES_VERDICT_URL=https://ai.rhautt.com/api/company-brain/strategy-verdict
# HERMES_VERDICT_TOKEN=

# ── Strategic plan import/export ──────────────────────────────────────────
# ORG_UNIT_ID=org-group-rhautt
# HORIZON_START=2026
# HORIZON_END=2028

# ── CI / harness ──────────────────────────────────────────────────────────
# STRATOS_HARNESS_BASE_URL=http://127.0.0.1:3003
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3003
# PLAYWRIGHT_NO_SERVER=1

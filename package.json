{
  "name": "strategy-driven-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "fonts:fetch": "npx tsx scripts/fetch-noto-font.ts",
    "setup": "npx tsx scripts/setup.ts",
    "setup:fonts": "npx tsx scripts/setup.ts --fonts-only",
    "setup:db": "npx tsx scripts/setup.ts --db-only",
    "workos:check": "npx tsx scripts/workos-setup-check.ts",
    "preflight": "npx tsx scripts/production-preflight.ts",
    "smoke": "npx tsx scripts/smoke-health.ts",
    "verify:persistence": "npx tsx scripts/verify-persistence.ts",
    "plan:import": "npx tsx scripts/import-strategic-plan.ts",
    "test": "node --import tsx --test lib/stratos/*.test.ts lib/audit/*.test.ts lib/panorama/*.test.ts lib/harness/*.test.ts lib/fpa/*.test.ts lib/culture/*.test.ts lib/command/*.test.ts lib/execution/*.test.ts lib/market-intel/*.test.ts lib/health/*.test.ts lib/decode/*.test.ts lib/nav/*.test.ts lib/data/*.test.ts lib/innovation/*.test.ts lib/compiler/import-quality.test.ts lib/compiler/import-deduction.test.ts lib/compiler/import-llm.test.ts lib/compiler/import-audit.test.ts lib/reports/pulse-dedup.test.ts lib/reports/report-queries.test.ts lib/env/*.test.ts lib/rate-limit.test.ts lib/auth/*.test.ts",
    "test:e2e": "playwright test",
    "test:compiler-chain": "npx tsx scripts/e2e-compiler-chain.ts",
    "harness": "npx tsx scripts/harness.ts",
    "harness:full": "npx tsx scripts/harness.ts --full",
    "harness:ci": "npx tsx scripts/harness.ts --ci",
    "check": "npm run harness:ci",
    "plan:export": "npx tsx scripts/export-strategic-plan.ts",
    "plan:restore": "npx tsx scripts/import-strategic-plan.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^5.22.0",
    "next": "16.2.9",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
